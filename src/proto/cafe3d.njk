<section class="hero" aria-label="Intro">
  <div class="centerpiece" data-proto-stage role="img" aria-label="A low-poly café interior at night, looking out a rainy window at a lamplit street"></div>
  <h1 class="hero-name">{{ site.name }}</h1>
  <p class="lede">I build software. This is where I keep what I make, what I write, and the work that inspires me.</p>
</section>

<section class="section">
  <h2 class="section-title"><a href="/projects/">Projects</a></h2>
  {% set items = projects | head(3) %}
  {% include "partials/project-list.njk" %}
</section>

<aside class="proto-panel" id="proto-panel" aria-label="Shader settings">
  <button type="button" class="proto-panel-toggle" aria-expanded="true" aria-controls="proto-panel-body">Shader</button>
  <div class="proto-panel-body" id="proto-panel-body"></div>
</aside>

<style>
[data-proto-stage] { background: #141a2e; position: relative; }
[data-proto-stage] canvas { width: 100%; height: 100%; display: block; }

.proto-panel {
  position: fixed; top: calc(12px + env(safe-area-inset-top, 0px)); right: calc(12px + env(safe-area-inset-right, 0px));
  z-index: 2147483646; width: 232px; max-height: calc(100dvh - 24px); overflow-y: auto;
  background: rgba(10, 10, 10, 0.86); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  color: rgba(255, 255, 255, 0.85); border-radius: 12px; padding: 6px;
  box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset, 0 8px 24px rgba(0, 0, 0, 0.24);
  font: 12px/1.3 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased;
}
.proto-panel-toggle {
  all: unset; box-sizing: border-box; width: 100%; padding: 8px 8px; cursor: pointer; font-weight: 600; color: #fff;
  display: flex; justify-content: space-between; border-radius: 8px;
}
.proto-panel-toggle::after { content: "–"; color: rgba(255,255,255,0.5); }
.proto-panel-toggle[aria-expanded="false"]::after { content: "+"; }
.proto-panel-toggle:focus-visible { outline: 2px solid rgba(255,255,255,0.4); }
.proto-panel-body { display: grid; gap: 10px; padding: 4px 8px 8px; }
.proto-panel-body[hidden] { display: none; }
.pp-row { display: grid; gap: 4px; }
.pp-row label { display: flex; justify-content: space-between; gap: 8px; }
.pp-row output { color: rgba(255,255,255,0.55); font-variant-numeric: tabular-nums; }
.pp-row input[type=range] { width: 100%; accent-color: #f2c46d; margin: 0; height: 24px; }
.pp-seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }
.pp-seg button { all: unset; text-align: center; padding: 6px 0; border-radius: 6px; cursor: pointer; background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.6); }
.pp-seg button[aria-pressed="true"] { background: rgba(255,255,255,0.18); color: #fff; }
.pp-seg button:focus-visible { outline: 2px solid rgba(255,255,255,0.4); }
.pp-copy {
  all: unset; box-sizing: border-box; text-align: center; padding: 8px; border-radius: 8px; cursor: pointer;
  background: rgba(255,255,255,0.1); color: #fff;
}
.pp-copy:active { transform: scale(0.97); }
.pp-copy:focus-visible { outline: 2px solid rgba(255,255,255,0.4); }
</style>

<script type="module" src="/assets/js/proto/cafe3d.js"></script>
