<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta name="color-scheme" content="light dark">
  <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1c1a18" media="(prefers-color-scheme: dark)">
  <link rel="preload" href="/assets/fonts/Mona-Sans.var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/main.css">
  <link rel="alternate" type="application/atom+xml" href="/writing/feed.xml" title="{{ site.name }}: Writing">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='12' fill='%23d9622b'/></svg>">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="page">
    <header class="site-header">
      <a class="site-name" href="/">{{ site.name }}</a>
      <nav aria-label="Main">
        {%- for item in site.nav %}
        <a href="{{ item.href }}"{% if page.url.startsWith(item.href) %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {%- endfor %}
      </nav>
    </header>
    <main id="main" class="transition-fade" tabindex="-1">
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      {%- for link in site.links %}
      <a href="{{ link.href }}">{{ link.label }}</a>
      {%- endfor %}
      <a href="/writing/feed.xml">RSS</a>
    </footer>
  </div>
  {% include "partials/player.njk" %}
  <script src="/assets/vendor/swup.js" defer></script>
  <script src="/assets/vendor/swup-head.js" defer></script>
  <script src="/assets/js/player.js" defer></script>
  <script src="/assets/js/app.js" defer></script>
</body>
</html>
