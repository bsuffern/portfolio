---
layout: layouts/base.njk
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="meta"><time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time></p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  {%- if originalUrl %}
  <p class="meta post-origin">First published on <a href="{{ originalUrl }}">Hashnode</a>.</p>
  {%- endif %}
  <p class="back"><a href="/writing/">← All writing</a></p>
</article>
